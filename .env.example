# NOVA server settings. Copy to .env or export them in your shell. NEVER commit real values.
# Start:  OWNER_EMAILS=you@gmail.com AUTH_MODE=dev node server/index.js     (then open http://127.0.0.1:8787)

# Who may sign in (comma-separated e-mail addresses). Required.
OWNER_EMAILS=you@example.com

# 'dev'    = local development sign-in (type an allowed e-mail). Only works on 127.0.0.1 / localhost.
# 'google' = real Google sign-in (free; needs the three Google values below).
AUTH_MODE=dev

# Google sign-in (free). Create an OAuth client of type "Web application" in Google Cloud Console.
# Authorised redirect URI: http://127.0.0.1:8787/auth/google/callback  (or https://your-domain/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the server when it is not on localhost (needed for correct redirect URLs and Secure cookies).
BASE_URL=

HOST=127.0.0.1
PORT=8787
# Where the SQLite database lives (keep it out of git; .nova/ is already ignored).
NOVA_DB=.nova/nova.db

SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=168

# AI model. 'local' = free built-in rules only (default).
#           'ollama' = a free model on your own computer (install Ollama, then: ollama pull qwen2.5:7b). Understands everyday phrasing.
#           'claude' = Claude (PAID API; set a spending limit!).
NOVA_AI_PROVIDER=local
NOVA_OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:3b for 8 GB RAM, qwen2.5:7b for 16 GB (default), qwen2.5:14b for strong machines.
NOVA_OLLAMA_MODEL=qwen2.5:7b
NOVA_OLLAMA_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=
NOVA_MODEL_CHAT=claude-sonnet-5-5
NOVA_MAX_TOKENS=800
# Hard stop for estimated AI spending per calendar month, in US dollars. Empty = no limit.
NOVA_MONTHLY_LIMIT_USD=

# ---- Daily use (Milestone 4) ----
# Encrypts stored account tokens (Gmail). A long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it NOVA refuses to connect Gmail. Keep it secret and keep a copy: losing it means reconnecting Gmail.
NOVA_SECRET_KEY=
# The scheduler runs the daily briefing, deadline check, follow-up nudges and e-mail check (Dubai time). 'off' disables it.
NOVA_SCHEDULER=on
NOVA_SCHEDULER_INTERVAL_MS=30000
# Optional free phone push: install the ntfy app, subscribe to a long random topic name, put it here.
# Anyone who knows the topic can read the messages, so treat it like a password. Leave empty for no phone push.
NOVA_NTFY_TOPIC=
NOVA_NTFY_URL=https://ntfy.sh
NOVA_NTFY_TOKEN=
# Gmail (read-only) uses the same Google OAuth client as sign-in. In Google Cloud: enable the Gmail API and add
#   http://127.0.0.1:8787/auth/gmail/callback   (or https://your-domain/auth/gmail/callback) as an authorised redirect URI.
NOVA_GMAIL_MAX=30
